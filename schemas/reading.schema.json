{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "reading.schema.json",
  "title": "书籍记录",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "records"],
  "properties": {
    "$schema": { "type": "string" },
    "records": {
      "type": "array",
      "items": { "$ref": "#/definitions/record" }
    }
  },
  "definitions": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "date", "review"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\s*\\S[\\s\\S]*$",
          "description": "书名。"
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\s*\\S[\\s\\S]*$",
          "description": "作者。"
        },
        "publishYear": {
          "type": "integer",
          "minimum": 1900,
          "description": "出版年份。不填时，「全部」页用阅读日期的年份。不能晚于明年。"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}(?:-(0[1-9]|1[0-2])(?:-(0[1-9]|[12]\\d|3[01]))?)?$",
          "description": "阅读日期。已知具体日期时填 YYYY-MM-DD，只记得月份时填 YYYY-MM，只记得年份时填 YYYY。"
        },
        "review": {
          "type": "string",
          "description": "短评。"
        }
      }
    }
  }
}
